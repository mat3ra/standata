        "dependencies": [
            "mpi/ompi-4.1.1"
        ],
        "environmentVariables": {}
    },
    "runConfig": {
        "commandTemplate": "{BASE_CMD} &&\n{MODULE_CMD}\nmpirun -machinefile {MACHINEFILE} -np {NP} $EXEC_CMD {EXECUTABLE} > {OUTPUTFILE}\n",
        "outFileName": "berkeleygw.out"
    }
}
