                        "content": "material: material.json\n\nmethod:\n  type: pseudopotential\n  subtype: ultrasoft\n\n  pseudopotentials:\n{%- for specie in input.ATOMIC_SPECIES %}\n    {{ specie.X }}: {{ specie.PseudoPot_X }}\n{%- endfor %}\n\n  cutoffs:\n    wavefunction: {{ cutoffs.wavefunction }}\n    density: {{ cutoffs.density }}\n\n  scf:\n    convergence_threshold: 1.0e-9\n    max_iterations: 100\n\n    smearing:\n      type: gaussian\n      degauss: 0.02\n\n    mixing:\n      beta: 0.3\n      mode: broyden\n\n    kgrid:\n      dimensions: [{{ kgrid.dimensions | join(', ') }}]\n      shifts: [{{ kgrid.shifts | join(', ') }}]\n\ncontrol:\n  calculation: scf\n  prefix: q3\n  outdir: ./outdir/\n",
