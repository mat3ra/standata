            "input": [
                {
                    "template": {
                        "applicationName": "q3",
                        "applicationVersion": "*",
                        "content": "{#- Non-self-consistent run on the effective potential of a preceding q3 SCF run (same prefix and\n    outdir, so the engine finds <outdir>/<prefix>.save/effective-potential.q3cp).\n    The q3 engine generates no k-points for an NSCF run: it reads control.kpoints_list as given and\n    applies no symmetry reduction. The list below is therefore the full (unreduced)\n    Monkhorst-Pack grid of this unit's k-grid, in crystal coordinates folded into [-0.5, 0.5), the\n    same convention as q3.workflows.pdos.monkhorst_pack_grid. Each point weighs 2 / (n1 * n2 * n3),\n    so the weights sum to 2 (spin degeneracy), as on the SCF grid. #}\n{%- set n1 = kgrid.dimensions[0] %}\n{%- set n2 = kgrid.dimensions[1] %}\n{%- set n3 = kgrid.dimensions[2] %}\n{%- set s1 = kgrid.shifts[0] %}\n{%- set s2 = kgrid.shifts[1] %}\n{%- set s3 = kgrid.shifts[2] %}\n{%- set weight = 2.0 / (n1 * n2 * n3) -%}\nmaterial: material.json\n\nmethod:\n  type: pseudopotential\n  subtype: ultrasoft\n\n  pseudopotentials:\n{%- for specie in input.ATOMIC_SPECIES %}\n    {{ specie.X }}: {{ specie.PseudoPot_X }}\n{%- endfor %}\n\n  cutoffs:\n    wavefunction: {{ cutoffs.wavefunction }}\n    density: {{ cutoffs.density }}\n\n  scf:\n    convergence_threshold: 1.0e-9\n    max_iterations: 100\n\n    smearing:\n      type: gaussian\n      degauss: 0.02\n\n    mixing:\n      beta: 0.3\n      mode: broyden\n\ncontrol:\n  calculation: nscf\n  prefix: q3\n  outdir: ./outdir/\n  kpoints_list:\n{%- for i in range(n1) %}\n{%- set x = i / n1 + (0.5 / n1 if s1 else 0.0) %}\n{%- set x = x - 1.0 if x >= 0.5 else x %}\n{%- for j in range(n2) %}\n{%- set y = j / n2 + (0.5 / n2 if s2 else 0.0) %}\n{%- set y = y - 1.0 if y >= 0.5 else y %}\n{%- for k in range(n3) %}\n{%- set z = k / n3 + (0.5 / n3 if s3 else 0.0) %}\n{%- set z = z - 1.0 if z >= 0.5 else z %}\n    - [{{ x | sprintf(\"%.9f\") }}, {{ y | sprintf(\"%.9f\") }}, {{ z | sprintf(\"%.9f\") }}, {{ weight | sprintf(\"%.12f\") }}]\n{%- endfor %}\n{%- endfor %}\n{%- endfor %}\n",
                        "contextProviders": [
                            {
                                "name": "Q3InputDataManager"
                            },
                            {
                                "name": "KGridFormDataManager"
                            },
                            {
                                "name": "PlanewaveCutoffDataManager"
                            }
                        ],
                        "executableName": "q3",
                        "name": "q3_nscf.yml",
                        "schemaVersion": "2022.8.16"
