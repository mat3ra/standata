                    "template": {
                        "applicationName": "berkeleygw",
                        "applicationVersion": "*",
                        "content": "{#- q-grid = WFN k-grid (full grid, see pw_bands_bgw_wfn.in), with q = 0 replaced by the small\n    q0 = (0, 0, q0_shift) that matches the WFNq offset (see pw_bands_bgw_wfnq.in). #}\n{%- set q0_shift = 0.001 %}\n{%- set n1 = kgrid.dimensions[0] %}\n{%- set n2 = kgrid.dimensions[1] %}\n{%- set n3 = kgrid.dimensions[2] -%}\n# Energy cutoff for the dielectric matrix (Ry)\nepsilon_cutoff 10.0\n\n# Total number of bands (occupied + unoccupied) used in the summation; must not exceed\n# nbnd in WFN (see pw_bands_bgw_wfn.in)\nnumber_bands 32\n\n# q-points in crystal coordinates: qx qy qz 1/scale_factor is_q0\nbegin qpoints\n{{ 0|sprintf(\"%14.9f\") }} {{ 0|sprintf(\"%14.9f\") }} {{ q0_shift|sprintf(\"%14.9f\") }}  1.0  1\n{% for i in range(n1) -%}\n{% for j in range(n2) -%}\n{% for k in range(n3) -%}\n{% if i or j or k -%}\n{{ (i / n1)|sprintf(\"%14.9f\") }} {{ (j / n2)|sprintf(\"%14.9f\") }} {{ (k / n3)|sprintf(\"%14.9f\") }}  1.0  0\n{% endif -%}\n{% endfor -%}\n{% endfor -%}\n{% endfor -%}\nend\n",
                        "contextProviders": [
                            {
                                "name": "KGridFormDataManager"
                            }
                        ],
