            "isDefault": false
        },
        {
            "name": "assign-defect-formation-energy",
            "type": "assignment",
            "operand": "DEFECT_FORMATION_ENERGY",
            "value": "TE_FOR_MATERIAL - E_PRISTINE - SUM_DELTA_N_TIMES_MU + (CHARGE * E_VBM if CHARGE else 0)",
            "input": [],
