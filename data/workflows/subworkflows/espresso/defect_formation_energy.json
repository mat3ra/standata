        },
        {
            "name": "assign-delta-n-by-symbol",
            "type": "assignment",
            "operand": "DELTA_N_BY_SYMBOL",
            "value": "{\n    el: len([e for e in MATERIAL.basis.elements if e[\"value\"] == el])\n      - len([e for e in PRISTINE.basis.elements if e[\"value\"] == el])\n    for el in ELEMENTS\n}",
            "input": [],
            "results": [],
            "monitors": [],
            "preProcessors": [],
            "postProcessors": [],
            "status": "idle",
            "statusTrack": [],
            "tags": [],
