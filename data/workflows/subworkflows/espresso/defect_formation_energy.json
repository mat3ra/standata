            "type": "assignment",
            "operand": "TE_CONTRIBUTIONS_BY_SYMBOL",
            "value": "{\n    el: {\n        \"formula\": el,\n        \"n_atoms\": len(ELEMENT_MATERIALS[el].basis.elements),\n        \"is_elemental\": True,\n        \"total_energy\": TE_FOR_ELEMENTAL_MATERIALS_MAP_BY_SYMBOL[el].data.value,\n        \"total_energy_per_atom\": TE_FOR_ELEMENTAL_MATERIALS_MAP_BY_SYMBOL[el].data.value\n        / len(ELEMENT_MATERIALS[el].basis.elements),\n        \"precision_value\": TE_FOR_ELEMENTAL_MATERIALS_MAP_BY_SYMBOL[el].precision.value,\n        \"precision_metric\": TE_FOR_ELEMENTAL_MATERIALS_MAP_BY_SYMBOL[el].precision.metric,\n    }\n    for el in ELEMENTS\n    if TE_FOR_ELEMENTAL_MATERIALS_MAP_BY_SYMBOL[el]\n}",
            "input": [],
