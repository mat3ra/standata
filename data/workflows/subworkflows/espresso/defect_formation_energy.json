            "isDefault": false
        },
        {
            "name": "assign-sum-delta-n-times-mu",
            "type": "assignment",
            "operand": "SUM_DELTA_N_TIMES_MU",
            "value": "sum(\n    DELTA_N_BY_SYMBOL[el] * TE_CONTRIBUTIONS_BY_SYMBOL[el][\"total_energy_per_atom\"]\n    for el in ELEMENTS\n    if el in TE_CONTRIBUTIONS_BY_SYMBOL\n)",
            "input": [],
            "results": [],
            "monitors": [],
            "preProcessors": [],
            "postProcessors": [],
            "status": "idle",
            "statusTrack": [],
            "tags": [],
            "flowchartId": "assign-sum-delta-n-times-mu",
