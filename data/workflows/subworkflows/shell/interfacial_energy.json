        {
            "name": "assign-n-substrate",
            "type": "assignment",
            "operand": "N_SUBSTRATE",
            "value": "len([e for e in INTERFACE.basis.elements if e.value in [x.value for x in BULK_SUBSTRATE.basis.elements]]) / BULK_SUBSTRATE_NATOMS",
            "input": [],
            "results": [],
