            "isDefault": false
        },
        {
            "name": "assign-te-excess",
            "type": "assignment",
            "operand": "TE_EXCESS",
            "value": "TE_INTERFACE - N_SUBSTRATE * TE_BULK_SUBSTRATE - N_FILM * TE_BULK_FILM",
            "input": [],
            "results": [],
            "monitors": [],
            "preProcessors": [],
