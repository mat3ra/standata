        {
            "name": "assign-n-film",
            "type": "assignment",
            "operand": "N_FILM",
            "value": "len([e for e in INTERFACE.basis.elements if e.value in [x.value for x in BULK_FILM.basis.elements] and e.value not in [x.value for x in BULK_SUBSTRATE.basis.elements]]) / BULK_FILM_NATOMS",
            "input": [],
            "results": [],
            "monitors": [],
            "preProcessors": [],
