        },
        {
            "name": "assign-interface-area",
            "type": "assignment",
            "operand": "INTERFACE_AREA",
            "value": "np.linalg.norm(np.cross(INTERFACE.lattice.vectors.a, INTERFACE.lattice.vectors.b))",
            "input": [],
            "results": [],
            "monitors": [],
            "preProcessors": [],
