                    "input": [
                        {
                            "template": {
                                "applicationName": "espresso",
                                "applicationVersion": "*",
                                "content": "{#- pw2bgw.x writes output files to outdir/<file>; the \"../\" prefix places them in the job\n    working directory, where the BerkeleyGW executables expect them.\n    real_or_complex selects the BerkeleyGW flavor the wavefunctions are written for:\n      1 - real flavor (*.real.x): for systems with both inversion symmetry (about the origin) and\n          time-reversal symmetry, where wavefunctions can be chosen real, saving memory and cost.\n      2 - complex flavor (*.cplx.x, default): required for general symmetry, magnetism, or\n          spin-orbit coupling, where wavefunctions are inherently complex.\n    It must match the flavor of the BerkeleyGW executables in the workflow (epsilon.cplx.x). -#}\n&input_pw2bgw\n    prefix = '__prefix__'\n    outdir = {% raw %}'{{ JOB_WORK_DIR }}/outdir'{% endraw %}\n    real_or_complex = 2\n    wfng_flag = .true.\n    wfng_file = '../WFN'\n    wfng_kgrid = .true.\n    wfng_nk1 = {{ kgrid.dimensions[0] }}\n    wfng_nk2 = {{ kgrid.dimensions[1] }}\n    wfng_nk3 = {{ kgrid.dimensions[2] }}\n    wfng_dk1 = 0.0\n    wfng_dk2 = 0.0\n    wfng_dk3 = 0.0\n    rhog_flag = .true.\n    rhog_file = '../RHO'\n{#- vxc_diag_nmax must not exceed nbnd in pw_bands_bgw_wfn.in #}\n    vxc_flag = .true.\n    vxc_file = '../vxc.dat'\n    vxc_diag_nmin = 1\n    vxc_diag_nmax = 35\n    vxc_offdiag_nmin = 0\n    vxc_offdiag_nmax = 0\n/\n",
                                "contextProviders": [
                                    {
                                        "name": "KGridFormDataManager"
                                    }
                                ],
                                "executableName": "pw2bgw.x",
                                "name": "pw2bgw_wfn.in",
                                "schemaVersion": "2022.8.16"
                            },
