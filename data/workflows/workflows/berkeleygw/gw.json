                                "content": "{#- See pw2bgw_wfn.j2.in. Sigma reads the same wavefunctions as Epsilon, but under the name\n    WFN_inner, so the WFN bands are converted a second time; it must run before the WFNq bands\n    run overwrites them in outdir. RHO and vxc.dat are already written by pw2bgw_wfn.in. -#}\n&input_pw2bgw\n    prefix = '__prefix__'\n    outdir = {% raw %}'{{ JOB_WORK_DIR }}/outdir'{% endraw %}\n    real_or_complex = 2\n    wfng_flag = .true.\n    wfng_file = '../WFN_inner'\n    wfng_kgrid = .true.\n    wfng_nk1 = {{ kgrid.dimensions[0] }}\n    wfng_nk2 = {{ kgrid.dimensions[1] }}\n    wfng_nk3 = {{ kgrid.dimensions[2] }}\n    wfng_dk1 = 0.0\n    wfng_dk2 = 0.0\n    wfng_dk3 = 0.0\n    rhog_flag = .false.\n    vxc_flag = .false.\n/\n",
